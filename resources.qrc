<RCC>
    <qresource prefix="/">

    <!-- Shaders -->
        <file>shaders/vertex.vert</file>
        <file>shaders/main.frag</file>
        <file>shaders/common.glsl</file>
        <file>shaders/colormaps.glsl</file>
        <file>shaders/healpix.glsl</file>
        <file>shaders/projections.glsl</file>
        <file>shaders/scale.glsl</file>
        <file>shaders/masks.glsl</file>
        <file>shaders/colorbar.frag</file>
        <file>shaders/colormapstrip.frag</file>
        <file>shaders/graticule.glsl</file>

        <!-- HEALPix pixel window functions (healpy.pixwin) -->
        <file alias="resources/pixwin/pixel_window_n0002.fits">thirdparty/healpix/data/pixel_window_n0002.fits</file>
        <file alias="resources/pixwin/pixel_window_n0004.fits">thirdparty/healpix/data/pixel_window_n0004.fits</file>
        <file alias="resources/pixwin/pixel_window_n0008.fits">thirdparty/healpix/data/pixel_window_n0008.fits</file>
        <file alias="resources/pixwin/pixel_window_n0016.fits">thirdparty/healpix/data/pixel_window_n0016.fits</file>
        <file alias="resources/pixwin/pixel_window_n0032.fits">thirdparty/healpix/data/pixel_window_n0032.fits</file>
        <file alias="resources/pixwin/pixel_window_n0064.fits">thirdparty/healpix/data/pixel_window_n0064.fits</file>
        <file alias="resources/pixwin/pixel_window_n0128.fits">thirdparty/healpix/data/pixel_window_n0128.fits</file>
        <file alias="resources/pixwin/pixel_window_n0256.fits">thirdparty/healpix/data/pixel_window_n0256.fits</file>
        <file alias="resources/pixwin/pixel_window_n0512.fits">thirdparty/healpix/data/pixel_window_n0512.fits</file>
        <file alias="resources/pixwin/pixel_window_n1024.fits">thirdparty/healpix/data/pixel_window_n1024.fits</file>
        <file alias="resources/pixwin/pixel_window_n2048.fits">thirdparty/healpix/data/pixel_window_n2048.fits</file>
        <file alias="resources/pixwin/pixel_window_n4096.fits">thirdparty/healpix/data/pixel_window_n4096.fits</file>
        <file alias="resources/pixwin/pixel_window_n8192.fits">thirdparty/healpix/data/pixel_window_n8192.fits</file>

        <!-- Licence text, shown in the About dialog -->
        <file>LICENSE</file>

        <!-- Usage guide, shown in Help > Usage -->
        <file>docs/USAGE.md</file>

        <!-- Fonts -->
        <file>resources/fonts/Major-Mono-Display.ttf</file>

        <!-- Theoretical CMB spectra (Planck Legacy Archive) -->
        <file>resources/theory/planck2018_bestfit.txt</file>

        <!-- QML -->
        <file>src/qml/powerspectrumplot.qml</file>
        <file>src/qml/histogram.qml</file>

    </qresource>
</RCC>

<!-- vim: set ft=xml: -->
